<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.khupdater.agent</string>
  <!-- __HOME__ is replaced at install (docs/INSTALL.md). The stub runs current/khu agent with base/config.json. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Library/KHUpdater/bin/khu-stub</string>
    <string>--base</string>
    <string>__HOME__/Library/KHUpdater/base</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/khupdater-agent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/khupdater-agent.log</string>
</dict>
</plist>
